# ============ SePay (thanh toán chuyển khoản) ============
# Ngân hàng + số tài khoản đã liên kết trong SePay. Tên ngân hàng theo danh sách của VietQR/SePay
# (VD: Vietcombank, MBBank, ACB, BIDV, Techcombank, VPBank, TPBank...)
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# API Key bạn tự đặt trong SePay → Tích hợp WebHooks (kiểu chứng thực "API Key").
SEPAY_WEBHOOK_API_KEY=
# Tiền tố mã đơn trong nội dung chuyển khoản, VD NGX → NGX12345678.
# Nên cấu hình cùng tiền tố trong SePay → Cấu hình công ty → Cấu trúc mã thanh toán.
SEPAY_CODE_PREFIX=NGX

# ============ Lark (thông báo) ============
# Lark → nhóm chat → Settings → Bots → Add bot → Custom Bot → copy Webhook URL.
LARK_WEBHOOK_URL=
# Chỉ điền nếu bot bật "Signature verification".
LARK_WEBHOOK_SECRET=

# ============ Lưu đơn hàng (MySQL) — BẮT BUỘC ============
# Tạo DB + user riêng trên VPS (xem README → "Cài MySQL"), rồi chạy `npm run db:migrate` để tạo bảng.
# Mật khẩu có ký tự đặc biệt (@ : / # ...) phải URL-encode.
DATABASE_URL=mysql://nextgency_app:MAT_KHAU@IP_VPS:3306/nextgency
# Bật TLS khi DB nằm trên VPS và mở ra Internet (rất nên bật). Chứng chỉ tự ký thì thêm dòng REJECT_UNAUTHORIZED=false
DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Số kết nối tối đa mỗi instance serverless (mặc định 3)
# DATABASE_POOL_SIZE=3

# ============ Quản trị đơn hàng ============
# Token (>= 16 ký tự ngẫu nhiên) dùng cho API admin đổi trạng thái đơn tay + gọi cron. Để trống = tắt API admin.
ADMIN_TOKEN=
# (tuỳ chọn) Vercel Cron tự gửi header Authorization: Bearer <CRON_SECRET> khi gọi /api/cron/fulfill
CRON_SECRET=

# ============ Tự động mời GitHub sau khi thanh toán ============
# Repo của tổ chức chứa bộ cài, dạng "ten-org/ten-repo" (repo cá nhân không có quyền chỉ-đọc).
GITHUB_REPO=
# Fine-grained token (nên tạo bằng tài khoản bot riêng), Resource owner = tổ chức,
# chọn đúng repo trên, Repository permissions → Administration: Read and write.
# Để trống = tắt tự động mời; Lark sẽ báo "cần mời tay".
GITHUB_TOKEN=

# ============ Webhook gửi đi (để bạn gửi email cho khách) ============
# Khách vừa đăng ký (chưa thanh toán) → POST JSON tới URL này. Để trống = tắt.
WEBHOOK_ORDER_CREATED_URL=
# Khách đã thanh toán thành công → POST JSON tới URL này. Để trống = tắt.
WEBHOOK_ORDER_PAID_URL=
# Khoá ký HMAC-SHA256 (khuyến nghị) — bên nhận dùng để xác minh request thật. Chuỗi ngẫu nhiên dài.
WEBHOOK_SECRET=

# ============ Hiển thị ============
NEXT_PUBLIC_SITE_URL=https://nextgency.vn
NEXT_PUBLIC_CONTACT_ZALO=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
# Link đặt lịch hỗ trợ setup (Cal.com / Lark Calendar / Google appointment). Để trống = ẩn nút đặt lịch.
NEXT_PUBLIC_BOOKING_URL=

# ============ Thông tin pháp lý hiển thị trong trang Chính sách (tuỳ chọn) ============
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_TAX_ID=
